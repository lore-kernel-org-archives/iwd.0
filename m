Dear Denis, dear James,

Maybe you remember my last mail with subject 'IWD 2.20 does not support Fas=
t Roaming with NXP 88W9098 chipset' from Oct. 2024. In the meantime SEW has=
 prompted NXP devteam of India to implement FT-handover in the NXP driver f=
or NXP 88W9098 working with actual IWD releases. At May 2025 the NXP team s=
ucceeded with this task, but testing of this feature by SEW
was deferred about 8-10 months due to the parallel investigation & fixing o=
f a catastrophic NXP driver bug which led to a complete WLAN firmware hange=
r after random runtime, which only could be fixed by a power cycle of the W=
LAN module.

After NXP having fixed this very high prio issue in the NXP out-of-tree ker=
nel driver we started in Apr 2026 performing long-term FT-handover tests wi=
th IWD 3.12 and this new driver.
Now we observed several SEGVs in IWD when FT-handover failed due to deauth/=
disassoc by AP and a subsequent legacy reconnect is performed by IWD.

For debugging I added a lot of IWD debug prints and enabled the use of liba=
san.

Two different main issues occurred:

1.  SEGV at receipt of EAPOL M1 msg at legacy reconnect trial after failed =
FT-handover

See capture file 2026-06-30T13-10-44+0000_6.2s_wlan_filtered.pcapng & log-f=
ile 2026-06-30T13-10-44+0000_6.2s.log

2. SEGV at repeated roam scan process at legacy reconnect trial after faile=
d FT-handover

See capture file wlp_00357_20260612_0436-0440_cli01_wlan_filtered.pcapng & =
log-file segv_cli01_20260612_0438_journal.log

Here is my patch with bugfixes for both issues adopted to the IWD 3.12 main=
line source code:

From 3c442fe0e7c70be3989a8b6548a92fbdcd99f5f6 Mon Sep 17 00:00:00 2001
From: DEMODDIE <dierk.modrow@sew-eurodrive.de>
Date: Fri, 3 Jul 2026 09:07:56 +0200
Subject: [PATCH] Three bugfixes for iwd SEGVs at receipt of EAPOL M1 msg wi=
th
 legacy roaming and repeated roam scan after ft_auth-/ft_reassoc-timeout
 occurred:

  src/eapol.c: next try for a fix of SEGV fault at eapol_rx_packets when us=
ing mwifiex / NXP 88W9098 driver
  src/station.c: potential bugfix in station_roam_scan_notify to avoid NULL=
-Ptr access to var hs
  src/station.c: next try to fix a SEGV after auth timeout at FT roaming
---
 src/eapol.c   |  4 ++++
 src/station.c | 12 ++++++------
 2 files changed, 10 insertions(+), 6 deletions(-)

diff --git a/src/eapol.c b/src/eapol.c
index 372549c6..c2dc4e4c 100644
--- a/src/eapol.c
+++ b/src/eapol.c
@@ -2824,6 +2824,10 @@ void eapol_register(struct eapol_sm *sm)

        l_queue_push_head(state_machines, sm);

+       /* workaround against SEGV on fct. eapol_rx_packet by avoiding for =
two different eapol_frame_watches with different ids, but same eapol_sm ptr=
 */
+       if ((sm->watch_id > 0) && eapol_frame_watch_remove(sm->watch_id)) {
+               l_debug("existing frame_watch for sm=3D%p with id=3D%u succ=
essfully removed", sm, sm->watch_id);
+       }
        sm->watch_id =3D eapol_frame_watch_add(sm->handshake->ifindex,
                                                rx_handler, sm);
        sm->protocol_version =3D sm->handshake->proto_version;
diff --git a/src/station.c b/src/station.c
index 8fcf8c70..077e510e 100644
--- a/src/station.c
+++ b/src/station.c
@@ -2253,7 +2253,7 @@ static bool station_can_fast_transition(struct statio=
n *station,
 {
        uint16_t mdid;

-       if (!hs->mde)
+       if (!hs || !hs->mde)
                return false;

        if (ie_parse_mobility_domain_from_data(hs->mde, hs->mde[1] + 2,
@@ -2917,7 +2917,7 @@ static bool station_roam_scan_notify(int err, struct =
l_queue *bss_list,

        orig_security =3D network_get_security(network);

-       if (hs->mde)
+       if (hs && hs->mde)
                ie_parse_mobility_domain_from_data(hs->mde, hs->mde[1] + 2,
                                                        &mdid, NULL, NULL);

@@ -2930,7 +2930,7 @@ static bool station_roam_scan_notify(int err, struct =
l_queue *bss_list,
        if (bss && !station->ap_directed_roaming) {
                double cur_bss_rank =3D bss->rank;

-               if (hs->mde && bss->mde_present && l_get_le16(bss->mde) =3D=
=3D mdid)
+               if (hs && hs->mde && bss->mde_present && l_get_le16(bss->md=
e) =3D=3D mdid)
                        cur_bss_rank *=3D RANK_FT_FACTOR;

                cur_bss_group_rank =3D evaluate_bss_group_rank(bss->addr,
@@ -2967,8 +2967,8 @@ static bool station_roam_scan_notify(int err, struct =
l_queue *bss_list,
                        goto next;

                /* Skip result if it is not part of the ESS */
-               if (bss->ssid_len !=3D hs->ssid_len ||
-                               memcmp(bss->ssid, hs->ssid, hs->ssid_len))
+               if (hs && (bss->ssid_len !=3D hs->ssid_len ||
+                               memcmp(bss->ssid, hs->ssid, hs->ssid_len)))
                        goto next;

                if (scan_bss_get_security(bss, &security) < 0)
@@ -2986,7 +2986,7 @@ static bool station_roam_scan_notify(int err, struct =
l_queue *bss_list,

                rank =3D bss->rank;

-               if (hs->mde && bss->mde_present && l_get_le16(bss->mde) =3D=
=3D mdid)
+               if (hs && hs->mde && bss->mde_present && l_get_le16(bss->md=
e) =3D=3D mdid)
                        rank *=3D RANK_FT_FACTOR;

                group_rank =3D evaluate_bss_group_rank(bss->addr, bss->freq=
uency,
--
2.53.0.windows.2

We tested a SEW-custom-specific IWD-version based on 3.12 with a similar pa=
tch - as shown above -  applied:
No further SEGVs occurred in this IWD version for about half a week of long=
-term testing, so the patch looks good for us.

So we wanted to submit the patch to IWD devlist to help other IWD users whi=
ch have either the NXP 88W9098  WLAN chipset or
older chipsets like NXP 88W8997, which maybe could use the softmac driver M=
arvell mwifiex.

